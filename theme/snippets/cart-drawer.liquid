{% comment %}
  Cart drawer markup.

  Re-rendered server-side through the Section Rendering API
  (sections/cart-drawer.liquid + PawlyCart.refresh), which is why every price
  here goes through Liquid `money` filters and no money formatting is
  duplicated in JavaScript.

  The drawer is an enhancement. /cart is the fallback and works with JS off.
{% endcomment %}

{%- liquid
  assign threshold = settings.cart_free_shipping_threshold | times: 100
  assign remaining = threshold | minus: cart.total_price
  assign remaining_money = remaining | money
  assign progress = 0
  if threshold > 0
    assign progress = cart.total_price | times: 100 | divided_by: threshold
    if progress > 100
      assign progress = 100
    endif
  endif
-%}

<aside
  class="cart-drawer"
  data-cart-drawer
  role="dialog"
  aria-modal="true"
  aria-label="{{ 'cart.general.title' | t }}"
  aria-hidden="true"
>
  <div class="cart-drawer__head">
    <h2>
      {{ 'cart.general.title' | t }}
      {%- if cart.item_count > 0 %}
        <span class="pawly-card__meta">({{ cart.item_count }})</span>
      {% endif -%}
    </h2>
    <button
      type="button"
      class="header__action"
      data-cart-close
      aria-label="{{ 'cart.general.close' | t }}"
    >
      {% render 'icon-close' %}
    </button>
  </div>

  <div class="cart-drawer__body">
    {%- if cart.item_count == 0 -%}
      <div class="empty-state">
        <h3>{{ 'cart.general.empty' | t }}</h3>
        <p>{{ 'cart.general.empty_body' | t }}</p>
        <a href="{{ routes.all_products_collection_url }}" class="btn btn--clay">
          {{ 'cart.general.continue_shopping' | t }}
        </a>
      </div>
    {%- else -%}
      <ul>
        {%- for line in cart.items -%}
          <li class="cart-line">
            <div class="cart-line__media">
              {%- if line.image -%}
                <img
                  src="{{ line.image | image_url: width: 160 }}"
                  alt="{{ line.image.alt | default: line.product.title | escape }}"
                  width="80"
                  height="80"
                  loading="lazy"
                >
              {%- else -%}
                {% render 'media-placeholder', label: '' %}
              {%- endif -%}
            </div>

            <div>
              <a href="{{ line.url }}" class="cart-line__title">{{ line.product.title }}</a>
              {%- unless line.variant.title contains 'Default' -%}
                <span class="cart-line__variant">{{ line.variant.title }}</span>
              {%- endunless -%}

              {%- if line.selling_plan_allocation -%}
                <span class="cart-line__variant">{{ line.selling_plan_allocation.selling_plan.name }}</span>
              {%- endif -%}

              <div class="cart-line__controls">
                <div class="qty">
                  <button
                    type="button"
                    data-cart-step
                    data-key="{{ line.key }}"
                    data-quantity="{{ line.quantity | minus: 1 }}"
                    aria-label="{{ 'products.product.quantity_decrease' | t }}"
                  >&minus;</button>
                  <input
                    type="number"
                    value="{{ line.quantity }}"
                    min="0"
                    inputmode="numeric"
                    data-cart-qty
                    data-key="{{ line.key }}"
                    aria-label="{{ 'cart.general.quantity' | t }}"
                  >
                  <button
                    type="button"
                    data-cart-step
                    data-key="{{ line.key }}"
                    data-quantity="{{ line.quantity | plus: 1 }}"
                    aria-label="{{ 'products.product.quantity_increase' | t }}"
                  >+</button>
                </div>
                <button
                  type="button"
                  class="cart-line__remove"
                  data-cart-remove
                  data-key="{{ line.key }}"
                >
                  {{ 'cart.general.remove' | t }}
                </button>
              </div>
            </div>

            <div class="cart-line__price">
              {{ line.final_line_price | money }}
              {%- if line.original_line_price > line.final_line_price -%}
                <br><del class="pawly-card__meta">{{ line.original_line_price | money }}</del>
              {%- endif -%}
            </div>
          </li>
        {%- endfor -%}
      </ul>
    {%- endif -%}
  </div>

  {%- if cart.item_count > 0 -%}
    <div class="cart-drawer__foot">
      {%- if settings.cart_free_shipping_bar and threshold > 0 -%}
        <div class="free-ship">
          <p class="free-ship__text">
            {%- if remaining > 0 -%}
              {{ 'cart.general.free_shipping_progress' | t: amount: remaining_money }}
            {%- else -%}
              {{ 'cart.general.free_shipping_reached' | t }}
            {%- endif -%}
          </p>
          <div
            class="free-ship__track"
            role="progressbar"
            aria-valuemin="0"
            aria-valuemax="100"
            aria-valuenow="{{ progress }}"
          >
            <div class="free-ship__fill" style="width: {{ progress }}%"></div>
          </div>
        </div>
      {%- endif -%}

      <div class="cart-totals">
        <span>{{ 'cart.general.subtotal' | t }}</span>
        <span>{{ cart.total_price | money }}</span>
      </div>
      <p class="cart-note">{{ 'cart.general.shipping_note' | t }}</p>

      <form action="{{ routes.cart_url }}" method="post" novalidate>
        <button type="submit" name="checkout" class="btn btn--primary btn--block btn--lg">
          {{ 'cart.general.checkout' | t }}
        </button>
      </form>

      <p style="margin: var(--sp-3) 0 0; text-align: center">
        <a href="{{ routes.cart_url }}" class="btn btn--ghost btn--sm">
          {{ 'cart.general.title' | t }}
        </a>
      </p>
    </div>
  {%- endif -%}
</aside>
