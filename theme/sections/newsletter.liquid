{% comment %}
  Email capture using Shopify's native customer form — a real signup, not a
  decorative input that goes nowhere.
{% endcomment %}

<section class="pawly-section" id="news-{{ section.id }}">
  <div class="pawly-container">
    <div class="newsletter__grid">
      <div>
        <h2>{{ section.settings.heading }}</h2>
        {%- if section.settings.body != blank -%}
          <p>{{ section.settings.body }}</p>
        {%- endif -%}

        {%- form 'customer', class: 'newsletter__form-wrap' -%}
          <input type="hidden" name="contact[tags]" value="newsletter">

          {%- if form.posted_successfully? -%}
            <p class="form-status form-status--success" role="status">
              {{ 'general.newsletter.success' | t }}
            </p>
          {%- elsif form.errors -%}
            <p class="form-status form-status--error" role="alert">
              {{ 'general.newsletter.error' | t }}
            </p>
          {%- endif -%}

          <div class="newsletter__form">
            <label class="visually-hidden" for="news-email-{{ section.id }}">
              {{ 'general.newsletter.placeholder' | t }}
            </label>
            <input
              id="news-email-{{ section.id }}"
              class="input"
              type="email"
              name="contact[email]"
              autocomplete="email"
              required
              placeholder="{{ 'general.newsletter.placeholder' | t }}"
            >
            <button type="submit" class="btn btn--clay">
              {{ 'general.newsletter.submit' | t }}
            </button>
          </div>
        {%- endform -%}
      </div>

      <div class="newsletter__media">
        {%- if section.settings.image != blank -%}
          <img
            src="{{ section.settings.image | image_url: width: 1000 }}"
            srcset="
              {{ section.settings.image | image_url: width: 600 }} 600w,
              {{ section.settings.image | image_url: width: 1000 }} 1000w
            "
            sizes="(min-width: 900px) 50vw, 100vw"
            alt="{{ section.settings.image.alt | escape }}"
            width="{{ section.settings.image.width }}"
            height="{{ section.settings.image.height }}"
            loading="lazy"
            decoding="async"
          >
        {%- else -%}
          {% render 'media-placeholder', label: '' %}
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "הרשמה לרשימה",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "כותרת",
      "default": "הצטרפו לחבורה של Pawly"
    },
    {
      "type": "textarea",
      "id": "body",
      "label": "טקסט",
      "default": "מדי פעם מייל עם מוצר חדש או טיפ קצר. בלי ספאם, ואפשר להסיר את עצמכם בקליק."
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "תמונה",
      "info": "משהו משועשע ולא קטלוגי — הרגיסטר הנכון לאיסוף מיילים."
    }
  ],
  "presets": [
    {
      "name": "הרשמה לרשימה"
    }
  ]
}
{% endschema %}
