{% comment %}
  Category cards with a 3D tilt on pointer devices.

  The tilt maths lives in pawly.js (initTilt). The bug in the merchant's
  original snippet was `e.offsetX / card.width` — DOM elements have no `.width`
  property, so that expression evaluated NaN and the tilt silently did nothing.
  It now measures with getBoundingClientRect().

  Max rotation is 14°, not 20–25°: past roughly 15° the photo perspective stops
  reading as depth and starts reading as a rendering glitch.

  Touch devices get a clean scale-on-tap from CSS and no tilt at all.
{% endcomment %}

<section class="pawly-section" id="cats-{{ section.id }}">
  <div class="pawly-container">
    {%- if section.settings.heading != blank -%}
      <div class="pawly-section__head">
        <h2>{{ section.settings.heading }}</h2>
      </div>
    {%- endif -%}

    <div class="cat-grid">
      {%- for block in section.blocks -%}
        {%- liquid
          assign link = block.settings.link
          if link == blank
            assign link = routes.all_products_collection_url
          endif
        -%}
        <a
          href="{{ link }}"
          class="cat-card reveal"
          data-tilt
          {{ block.shopify_attributes }}
        >
          <div class="cat-card__media">
            {%- if block.settings.image != blank -%}
              <img
                src="{{ block.settings.image | image_url: width: 900 }}"
                srcset="
                  {{ block.settings.image | image_url: width: 500 }} 500w,
                  {{ block.settings.image | image_url: width: 900 }} 900w,
                  {{ block.settings.image | image_url: width: 1300 }} 1300w
                "
                sizes="(min-width: 900px) 33vw, 100vw"
                alt="{{ block.settings.image.alt | default: block.settings.title | escape }}"
                width="{{ block.settings.image.width }}"
                height="{{ block.settings.image.height }}"
                loading="lazy"
                decoding="async"
              >
            {%- else -%}
              {% render 'media-placeholder', label: '' %}
            {%- endif -%}
          </div>

          <span class="cat-card__scan" aria-hidden="true"></span>

          <div class="cat-card__overlay">
            <h3 class="cat-card__title">{{ block.settings.title }}</h3>
            <span class="cat-card__cta">
              {{ 'sections.categories.cta' | t }}
              {% render 'icon-arrow' %}
            </span>
          </div>
        </a>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "כרטיסי קטגוריה",
  "max_blocks": 4,
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "כותרת",
      "default": "מה מחפשים היום?"
    }
  ],
  "blocks": [
    {
      "type": "card",
      "name": "כרטיס",
      "settings": [
        { "type": "text", "id": "title", "label": "שם הקטגוריה" },
        { "type": "url", "id": "link", "label": "קישור" },
        {
          "type": "image_picker",
          "id": "image",
          "label": "תמונה",
          "info": "לאורך, יחס 3:4. אם אין תמונה מוצג משטח קרם עם סמל הכפה."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "כרטיסי קטגוריה",
      "blocks": [
        { "type": "card", "settings": { "title": "כלבים" } },
        { "type": "card", "settings": { "title": "חתולים" } },
        { "type": "card", "settings": { "title": "טיפוח כפות" } }
      ]
    }
  ]
}
{% endschema %}
