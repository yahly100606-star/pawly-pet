{%- assign order_date = order.created_at | date: '%d.%m.%Y' -%}

<div class="pawly-container pawly-section">
  <div class="page-head">
    <h1>{{ 'customer.order.title' | t: name: order.name }}</h1>
    <p class="pawly-card__meta">{{ 'customer.order.date_html' | t: date: order_date }}</p>
    {%- if order.cancelled -%}
      {%- assign cancelled_date = order.cancelled_at | date: '%d.%m.%Y' -%}
      <p class="form-status form-status--error">
        {{ 'customer.order.cancelled_html' | t: date: cancelled_date }}
        {%- if order.cancel_reason %} · {{ 'customer.order.cancelled_reason' | t: reason: order.cancel_reason_label }}{% endif -%}
      </p>
    {%- endif -%}
  </div>

  <div class="account__grid">
    <div class="card-panel" style="overflow-x: auto">
      <table class="data-table">
        <thead>
          <tr>
            <th scope="col">{{ 'customer.order.product' | t }}</th>
            <th scope="col">{{ 'customer.order.sku' | t }}</th>
            <th scope="col">{{ 'customer.order.price' | t }}</th>
            <th scope="col">{{ 'customer.order.quantity' | t }}</th>
            <th scope="col">{{ 'customer.order.total' | t }}</th>
          </tr>
        </thead>
        <tbody>
          {%- for line in order.line_items -%}
            <tr>
              <td>
                {{ line.title }}
                {%- if line.fulfillment -%}
                  <br>
                  {%- if line.fulfillment.tracking_url -%}
                    <a href="{{ line.fulfillment.tracking_url }}" class="pawly-card__meta">
                      {{ 'customer.order.track_shipment' | t }}
                    </a>
                  {%- endif -%}
                {%- endif -%}
              </td>
              <td>{{ line.sku }}</td>
              <td>{{ line.original_price | money }}</td>
              <td>{{ line.quantity }}</td>
              <td>{{ line.final_line_price | money }}</td>
            </tr>
          {%- endfor -%}
        </tbody>
        <tfoot>
          <tr>
            <th scope="row" colspan="4">{{ 'customer.order.subtotal' | t }}</th>
            <td>{{ order.line_items_subtotal_price | money }}</td>
          </tr>
          {%- for shipping in order.shipping_methods -%}
            <tr>
              <th scope="row" colspan="4">{{ 'customer.order.shipping' | t }} ({{ shipping.title }})</th>
              <td>{{ shipping.price | money }}</td>
            </tr>
          {%- endfor -%}
          {%- for tax in order.tax_lines -%}
            <tr>
              <th scope="row" colspan="4">{{ 'customer.order.tax' | t }} ({{ tax.title }})</th>
              <td>{{ tax.price | money }}</td>
            </tr>
          {%- endfor -%}
          <tr>
            <th scope="row" colspan="4">{{ 'customer.order.total' | t }}</th>
            <td><strong>{{ order.total_price | money }}</strong></td>
          </tr>
        </tfoot>
      </table>
    </div>

    <aside>
      <div class="card-panel" style="margin-bottom: var(--sp-4)">
        <h2 style="font-size: var(--step-1)">{{ 'customer.order.shipping_address' | t }}</h2>
        {{ order.shipping_address | format_address }}
      </div>
      <div class="card-panel">
        <h2 style="font-size: var(--step-1)">{{ 'customer.order.billing_address' | t }}</h2>
        {{ order.billing_address | format_address }}
        <p class="pawly-card__meta" style="margin: var(--sp-3) 0 0">
          {{ 'customer.order.payment_status' | t }}: {{ order.financial_status_label }}
        </p>
      </div>
      <p style="margin-top: var(--sp-4)">
        <a href="{{ routes.account_url }}" class="btn btn--ghost btn--sm">
          {{ 'customer.account.return' | t }}
        </a>
      </p>
    </aside>
  </div>
</div>

{% schema %}
{
  "name": "הזמנה"
}
{% endschema %}
