{%- liquid
  assign per_page = section.settings.per_page | default: 12
  assign sort_by = collection.sort_by | default: collection.default_sort_by
-%}

<div class="pawly-container pawly-section">
  <div class="page-head">
    <h1>{{ collection.title }}</h1>
    {%- if collection.description != blank -%}
      <div class="rte narrow">{{ collection.description }}</div>
    {%- endif -%}
  </div>

  {%- comment -%}
    Filtering is plain links, sorting is a form with a submit button. Both work
    with JavaScript disabled; the button hides itself when JS is available.
  {%- endcomment -%}
  <div class="collection__bar">
    {%- if section.settings.show_tag_filter and collection.all_tags.size > 0 -%}
      <div class="collection__filters">
        <a
          href="{{ collection.url }}"
          class="filter-pill"
          {% if current_tags == blank %}aria-current="true"{% endif %}
        >
          {{ 'products.facets.clear_all' | t }}
        </a>
        {%- for tag in collection.all_tags -%}
          <a
            href="{{ collection.url }}/{{ tag | handleize }}"
            class="filter-pill"
            {% if current_tags contains tag %}aria-current="true"{% endif %}
          >
            {{ tag }}
          </a>
        {%- endfor -%}
      </div>
    {%- else -%}
      <span class="collection__count">
        {{- 'products.facets.results' | t: count: collection.products_count -}}
      </span>
    {%- endif -%}

    <form method="get" action="{{ collection.url }}" data-sort-form>
      <label class="visually-hidden" for="sort-by">{{ 'products.facets.sort' | t }}</label>
      <select id="sort-by" name="sort_by" class="select" data-sort-select>
        {%- for option in collection.sort_options -%}
          <option value="{{ option.value }}" {% if option.value == sort_by %}selected{% endif %}>
            {{ option.name }}
          </option>
        {%- endfor -%}
      </select>
      <noscript>
        <button type="submit" class="btn btn--outline btn--sm">
          {{ 'products.facets.apply' | t }}
        </button>
      </noscript>
    </form>
  </div>

  {%- paginate collection.products by per_page -%}
    {%- if collection.products.size > 0 -%}
      <div class="product-grid" style="--grid-cols: {{ section.settings.columns }}">
        {%- for product in collection.products -%}
          <div class="reveal">
            {% render 'product-card', product: product, eager: forloop.first %}
          </div>
        {%- endfor -%}
      </div>

      {%- if paginate.pages > 1 -%}
        <nav class="pagination" aria-label="{{ 'general.pagination.label' | t }}">
          {%- if paginate.previous -%}
            <a href="{{ paginate.previous.url }}" aria-label="{{ 'general.pagination.previous' | t }}">
              {{- '‹' -}}
            </a>
          {%- endif -%}

          {%- for part in paginate.parts -%}
            {%- if part.is_link -%}
              <a href="{{ part.url }}">{{ part.title }}</a>
            {%- else -%}
              <span {% if part.title == paginate.current_page %}aria-current="page"{% endif %}>
                {{- part.title -}}
              </span>
            {%- endif -%}
          {%- endfor -%}

          {%- if paginate.next -%}
            <a href="{{ paginate.next.url }}" aria-label="{{ 'general.pagination.next' | t }}">
              {{- '›' -}}
            </a>
          {%- endif -%}
        </nav>
      {%- endif -%}
    {%- else -%}
      <div class="empty-state">
        <h2>{{ 'products.facets.empty' | t }}</h2>
        <a href="{{ routes.all_products_collection_url }}" class="btn btn--outline">
          {{ 'sections.featured.view_all' | t }}
        </a>
      </div>
    {%- endif -%}
  {%- endpaginate -%}
</div>

<script>
  (function () {
    var form = document.querySelector('[data-sort-form]');
    var select = document.querySelector('[data-sort-select]');
    if (form && select) {
      select.addEventListener('change', function () {
        form.submit();
      });
    }
  })();
</script>

{% schema %}
{
  "name": "אוסף",
  "settings": [
    {
      "type": "range",
      "id": "per_page",
      "label": "מוצרים בעמוד",
      "min": 8,
      "max": 24,
      "step": 4,
      "default": 12
    },
    {
      "type": "range",
      "id": "columns",
      "label": "עמודות במחשב",
      "min": 2,
      "max": 4,
      "step": 1,
      "default": 4
    },
    {
      "type": "checkbox",
      "id": "show_tag_filter",
      "label": "סינון לפי תגית",
      "default": true
    }
  ]
}
{% endschema %}
