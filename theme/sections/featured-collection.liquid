{%- liquid
  assign collection = collections[section.settings.collection]
  assign limit = section.settings.limit | default: 4
  assign products = collection.products
  if collection == blank or products.size == 0
    assign products = collections.all.products
  endif
-%}

<section class="pawly-section" id="featured-{{ section.id }}">
  <div class="pawly-container">
    <div class="pawly-section__head">
      {%- if section.settings.heading != blank -%}
        <h2>{{ section.settings.heading }}</h2>
      {%- endif -%}
      {%- if section.settings.subheading != blank -%}
        <p>{{ section.settings.subheading }}</p>
      {%- endif -%}
    </div>

    {%- if products.size > 0 -%}
      <div class="product-grid" style="--grid-cols: {{ section.settings.columns }}">
        {%- for product in products limit: limit -%}
          <div class="reveal">
            {% render 'product-card', product: product %}
          </div>
        {%- endfor -%}
      </div>

      {%- if section.settings.show_view_all -%}
        <p style="margin: var(--sp-6) 0 0; text-align: center">
          <a
            href="{% if collection != blank %}{{ collection.url }}{% else %}{{ routes.all_products_collection_url }}{% endif %}"
            class="btn btn--outline"
          >
            {{ 'sections.featured.view_all' | t }}
          </a>
        </p>
      {%- endif -%}
    {%- else -%}
      {%- comment -%}
        Nothing published yet — all six products are DRAFT. Say so plainly in
        the editor rather than rendering an empty grid the merchant can't debug.
      {%- endcomment -%}
      <div class="empty-state">
        <p>[דרוש מידע: אין מוצרים פעילים באוסף הזה. המוצרים עדיין בטיוטה.]</p>
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "אוסף מוצרים",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "כותרת",
      "default": "המוצרים שלנו"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "תת־כותרת",
      "default": "שישה כלים, כל אחד לבעיה אחת ספציפית."
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "אוסף",
      "info": "אם לא נבחר אוסף מוצגים כל המוצרים הפעילים."
    },
    {
      "type": "range",
      "id": "limit",
      "label": "מספר מוצרים",
      "min": 2,
      "max": 12,
      "step": 1,
      "default": 4
    },
    {
      "type": "range",
      "id": "columns",
      "label": "עמודות במחשב",
      "min": 2,
      "max": 4,
      "step": 1,
      "default": 4,
      "info": "במובייל תמיד שתי עמודות."
    },
    {
      "type": "checkbox",
      "id": "show_view_all",
      "label": "כפתור “לכל המוצרים”",
      "default": true
    }
  ],
  "presets": [
    {
      "name": "אוסף מוצרים"
    }
  ]
}
{% endschema %}
