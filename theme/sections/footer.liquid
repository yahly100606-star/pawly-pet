{% comment %}
  Port of Footerdemo: four columns — newsletter capture / quick links / contact
  / social.

  Three deliberate omissions from the React source:
    · No dark-mode toggle. This store has no dark theme, and a toggle that does
      nothing is worse than no toggle.
    · Tooltips are CSS-only (data-tip + ::after in pawly.css). No Radix.
    · Social icons render only when the URL is filled in — no placeholder
      Twitter/LinkedIn pointing at "#".

  The contact block shows real settings or a visible [דרוש מידע] marker.
  It never shows an invented address.
{% endcomment %}

<footer class="footer">
  <div class="pawly-container">
    <div class="footer__grid">
      {%- comment -%} 1. Brand + newsletter {%- endcomment -%}
      <div class="footer__newsletter">
        <div class="footer__logo">
          {%- if settings.logo_full != blank -%}
            <img
              src="{{ settings.logo_full | image_url: width: 320 }}"
              alt="{{ 'brand.logo_alt' | t }}"
              width="120"
              height="120"
              loading="lazy"
            >
          {%- else -%}
            <h3 style="font-family: var(--font-display); font-size: var(--step-2)">
              {{ shop.name }}
            </h3>
          {%- endif -%}
        </div>

        <p>{{ section.settings.tagline }}</p>

        {%- form 'customer' -%}
          <input type="hidden" name="contact[tags]" value="newsletter">
          {%- if form.posted_successfully? -%}
            <p class="form-status form-status--success" role="status">
              {{ 'general.newsletter.success' | t }}
            </p>
          {%- endif -%}
          <div class="newsletter__form" style="margin-top: var(--sp-3)">
            <label class="visually-hidden" for="footer-email">
              {{ 'general.newsletter.placeholder' | t }}
            </label>
            <input
              id="footer-email"
              class="input"
              type="email"
              name="contact[email]"
              autocomplete="email"
              required
              placeholder="{{ 'general.newsletter.placeholder' | t }}"
            >
            <button type="submit" class="btn btn--primary">
              {{ 'general.newsletter.submit' | t }}
            </button>
          </div>
        {%- endform -%}
      </div>

      {%- comment -%} 2. Quick links {%- endcomment -%}
      <div>
        <h3>{{ 'sections.footer.links_heading' | t }}</h3>
        <ul class="footer__list">
          {%- for link in section.settings.menu.links -%}
            <li><a href="{{ link.url }}">{{ link.title }}</a></li>
          {%- endfor -%}
        </ul>
      </div>

      {%- comment -%} 3. Contact — real details or a visible gap marker {%- endcomment -%}
      <div>
        <h3>{{ 'sections.footer.contact_heading' | t }}</h3>
        <ul class="footer__list">
          <li>
            {%- if settings.contact_email != blank -%}
              <a href="mailto:{{ settings.contact_email }}">{{ settings.contact_email }}</a>
            {%- else -%}
              {{ 'info_needed.email' | t }}
            {%- endif -%}
          </li>
          <li>
            {%- if settings.contact_phone != blank -%}
              <a href="tel:{{ settings.contact_phone | remove: ' ' | remove: '-' }}" dir="ltr">
                {{- settings.contact_phone -}}
              </a>
            {%- else -%}
              {{ 'info_needed.phone' | t }}
            {%- endif -%}
          </li>
          <li>
            {%- if settings.contact_hours != blank -%}
              {{ settings.contact_hours }}
            {%- else -%}
              {{ 'info_needed.hours' | t }}
            {%- endif -%}
          </li>
          {%- if settings.business_details != blank -%}
            <li>{{ settings.business_details }}</li>
          {%- else -%}
            <li>{{ 'info_needed.address' | t }}</li>
          {%- endif -%}
        </ul>
      </div>

      {%- comment -%} 4. Social — only what actually exists {%- endcomment -%}
      <div>
        <h3>{{ 'sections.footer.social_heading' | t }}</h3>
        <div class="footer__social">
          {%- if settings.social_instagram != blank -%}
            <a
              href="{{ settings.social_instagram }}"
              data-tip="Instagram"
              aria-label="Instagram"
              rel="noopener"
              target="_blank"
            >
              {% render 'icon-instagram' %}
            </a>
          {%- endif -%}

          {%- if settings.social_facebook != blank -%}
            <a
              href="{{ settings.social_facebook }}"
              data-tip="Facebook"
              aria-label="Facebook"
              rel="noopener"
              target="_blank"
            >
              {% render 'icon-facebook' %}
            </a>
          {%- endif -%}

          {%- if settings.contact_whatsapp != blank -%}
            <a
              href="https://wa.me/{{ settings.contact_whatsapp | remove: ' ' | remove: '-' | remove: '+' }}"
              data-tip="WhatsApp"
              aria-label="WhatsApp"
              rel="noopener"
              target="_blank"
            >
              {% render 'icon-whatsapp' %}
            </a>
          {%- endif -%}

          {%- if settings.social_tiktok != blank -%}
            <a
              href="{{ settings.social_tiktok }}"
              data-tip="TikTok"
              aria-label="TikTok"
              rel="noopener"
              target="_blank"
            >
              {% render 'icon-tiktok' %}
            </a>
          {%- endif -%}
        </div>

        {%- if settings.social_instagram == blank
          and settings.social_facebook == blank
          and settings.contact_whatsapp == blank
          and settings.social_tiktok == blank
        -%}
          <p style="font-size: var(--step--1)">{{ 'info_needed.instagram' | t }}</p>
        {%- endif -%}
      </div>
    </div>

    {%- assign current_year = 'now' | date: '%Y' -%}
    <div class="footer__bottom">
      <span>{{ 'sections.footer.copyright' | t: year: current_year }}</span>

      <ul class="footer__policies">
        {%- if shop.privacy_policy -%}
          <li><a href="{{ shop.privacy_policy.url }}">{{ shop.privacy_policy.title }}</a></li>
        {%- endif -%}
        {%- if shop.terms_of_service -%}
          <li><a href="{{ shop.terms_of_service.url }}">{{ shop.terms_of_service.title }}</a></li>
        {%- endif -%}
        {%- if shop.refund_policy -%}
          <li><a href="{{ shop.refund_policy.url }}">{{ shop.refund_policy.title }}</a></li>
        {%- endif -%}
        {%- if shop.shipping_policy -%}
          <li><a href="{{ shop.shipping_policy.url }}">{{ shop.shipping_policy.title }}</a></li>
        {%- endif -%}
      </ul>

      {%- if settings.payment_icons_enable -%}
        <div class="footer__payments">
          <span class="visually-hidden">{{ 'sections.footer.payment_heading' | t }}</span>
          {%- if settings.payment_visa %}{% render 'icon-payment-visa' %}{% endif -%}
          {%- if settings.payment_mastercard %}{% render 'icon-payment-mastercard' %}{% endif -%}
          {%- if settings.payment_amex %}{% render 'icon-payment-amex' %}{% endif -%}
          {%- if settings.payment_bit %}{% render 'icon-payment-bit' %}{% endif -%}
          {%- if settings.payment_applepay %}{% render 'icon-payment-applepay' %}{% endif -%}
        </div>
      {%- endif -%}
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "פוטר",
  "settings": [
    {
      "type": "textarea",
      "id": "tagline",
      "label": "שורת תיאור",
      "default": "כלים לטיפוח כלבים וחתולים בבית."
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "תפריט ניווט",
      "default": "footer"
    },
    {
      "type": "paragraph",
      "content": "פרטי הקשר, הרשתות החברתיות ואייקוני התשלום נמצאים בהגדרות הערכה הכלליות."
    }
  ]
}
{% endschema %}
