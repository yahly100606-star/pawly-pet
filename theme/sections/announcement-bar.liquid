<div
  class="announcement"
  data-announcement
  data-key="{{ section.settings.text | strip_html | truncate: 24, '' | handleize }}"
  {% if section.settings.text == blank %}hidden{% endif %}
>
  <div class="pawly-container announcement__inner">
    <p class="announcement__text">
      {%- if section.settings.link != blank -%}
        <a href="{{ section.settings.link }}">{{ section.settings.text }}</a>
      {%- else -%}
        {{ section.settings.text }}
      {%- endif -%}
    </p>

    {%- if section.settings.dismissible -%}
      <button
        type="button"
        class="announcement__close"
        data-announcement-close
        aria-label="{{ 'sections.announcement.dismiss' | t }}"
      >
        {% render 'icon-close' %}
      </button>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "פס הודעה",
  "settings": [
    {
      "type": "text",
      "id": "text",
      "label": "ההודעה",
      "default": "🚚 משלוח חינם מעל ₪150 · החזר כספי מלא תוך 90 יום"
    },
    {
      "type": "url",
      "id": "link",
      "label": "קישור (לא חובה)"
    },
    {
      "type": "checkbox",
      "id": "dismissible",
      "label": "אפשר לסגור",
      "default": true,
      "info": "הסגירה נזכרת עד סוף הביקור בלבד (sessionStorage)."
    }
  ]
}
{% endschema %}
