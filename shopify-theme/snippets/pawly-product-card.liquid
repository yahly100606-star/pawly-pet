{%- comment -%}
  Pawly product card.
  Renders the real product; falls back to a branded paw placeholder while
  product photography is still missing (every product is currently image-less).

  Usage: {% render 'pawly-product-card', product: product, delay: 120 %}
{%- endcomment -%}

<article class="pawly-card pawly-reveal" style="--pawly-delay: {{ delay | default: 0 }}ms">
  <a
    class="pawly-card__media"
    href="{{ product.url }}"
    aria-label="{{ product.title | escape }}"
  >
    {%- if product.featured_image -%}
      <img
        src="{{ product.featured_image | image_url: width: 800 }}"
        srcset="
          {{ product.featured_image | image_url: width: 400 }} 400w,
          {{ product.featured_image | image_url: width: 800 }} 800w
        "
        sizes="(min-width: 900px) 25vw, 50vw"
        alt="{{ product.featured_image.alt | default: product.title | escape }}"
        width="800"
        height="800"
        loading="lazy"
      >
    {%- else -%}
      <span class="pawly-card__placeholder" aria-hidden="true">
        {%- render 'pawly-paw' -%}
      </span>
    {%- endif -%}

    {%- if product.compare_at_price > product.price -%}
      <span class="pawly-card__badge">{{ 'products.on_sale' | t }}</span>
    {%- elsif product.available == false -%}
      <span class="pawly-card__badge pawly-card__badge--muted">
        {{ 'products.sold_out' | t }}
      </span>
    {%- endif -%}
  </a>

  <div class="pawly-card__body">
    <h3 class="pawly-card__title">
      <a href="{{ product.url }}">{{ product.title }}</a>
    </h3>

    {%- if product.description != blank -%}
      <p class="pawly-card__desc">
        {{ product.description | strip_html | truncate: 110 }}
      </p>
    {%- endif -%}

    <div class="pawly-card__foot">
      <span class="pawly-card__price">
        {%- if product.compare_at_price > product.price -%}
          <del>{{ product.compare_at_price | money }}</del>
        {%- endif -%}
        {{ product.price | money }}
      </span>

      <a class="pawly-btn pawly-btn--primary pawly-btn--sm" href="{{ product.url }}">
        {{ 'products.view' | t }}
      </a>
    </div>
  </div>
</article>
