<section class="pawly-page">
  <div class="pawly-container">
    <div class="pawly-section-head">
      <h2>{{ collection.title }}</h2>
      {%- if collection.description != blank -%}
        <p>{{ collection.description | strip_html | truncate: 180 }}</p>
      {%- endif -%}
    </div>

    {%- paginate collection.products by 24 -%}
      {%- if collection.products.size > 0 -%}
        <div class="pawly-products">
          {%- for product in collection.products -%}
            {%- render 'pawly-product-card', product: product, delay: forloop.index0 | times: 60 -%}
          {%- endfor -%}
        </div>
        {%- if paginate.pages > 1 -%}
          <nav class="pawly-section-head" style="margin-top:3rem">{{ paginate | default_pagination }}</nav>
        {%- endif -%}
      {%- else -%}
        <p class="pawly-section-head">{{ 'products.empty' | t }}</p>
      {%- endif -%}
    {%- endpaginate -%}
  </div>
</section>

{% schema %}
{ "name": "Collection", "settings": [] }
{% endschema %}
