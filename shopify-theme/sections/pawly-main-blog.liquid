<section class="pawly-page">
  <div class="pawly-container">
    <div class="pawly-section-head"><h2>{{ blog.title }}</h2></div>
    {%- paginate blog.articles by 12 -%}
      <div class="pawly-products">
        {%- for article in blog.articles -%}
          <article class="pawly-card pawly-reveal">
            <a class="pawly-card__media" href="{{ article.url }}" aria-label="{{ article.title | escape }}">
              {%- if article.image -%}
                <img src="{{ article.image | image_url: width: 800 }}" alt="{{ article.title | escape }}" width="800" height="800" loading="lazy">
              {%- else -%}
                <span class="pawly-card__placeholder">{%- render 'pawly-paw' -%}</span>
              {%- endif -%}
            </a>
            <div class="pawly-card__body">
              <h3 class="pawly-card__title"><a href="{{ article.url }}">{{ article.title }}</a></h3>
              <p class="pawly-card__desc">{{ article.excerpt_or_content | strip_html | truncate: 110 }}</p>
            </div>
          </article>
        {%- endfor -%}
      </div>
      {%- if paginate.pages > 1 -%}
        <nav class="pawly-section-head" style="margin-top:3rem">{{ paginate | default_pagination }}</nav>
      {%- endif -%}
    {%- endpaginate -%}
  </div>
</section>

{% schema %}
{ "name": "Blog", "settings": [] }
{% endschema %}
