<section class="pawly-page">
  <div class="pawly-container">
    <div class="pawly-section-head"><h2>{{ 'cart.title' | t }}</h2></div>

    {%- if cart.item_count > 0 -%}
      {%- form 'cart', cart -%}
        <div style="max-width:48rem;margin-inline:auto">
          {%- for item in cart.items -%}
            <div class="pawly-card" style="flex-direction:row;align-items:center;gap:1rem;padding:1rem;margin-bottom:1rem">
              <a href="{{ item.url }}" style="width:5rem;flex:none;border-radius:var(--pawly-radius);overflow:hidden">
                {%- if item.image -%}
                  <img src="{{ item.image | image_url: width: 200 }}" alt="{{ item.title | escape }}" width="200" height="200" loading="lazy">
                {%- else -%}
                  <span class="pawly-card__placeholder" style="aspect-ratio:1/1">{%- render 'pawly-paw' -%}</span>
                {%- endif -%}
              </a>
              <div style="flex:1">
                <a href="{{ item.url }}" style="font-weight:600;text-decoration:none">{{ item.product.title }}</a>
                {%- unless item.variant.title contains 'Default' -%}
                  <div style="color:var(--pawly-muted);font-size:.9rem">{{ item.variant.title }}</div>
                {%- endunless -%}
              </div>
              <input type="number" name="updates[]" value="{{ item.quantity }}" min="0" aria-label="{{ 'cart.quantity' | t }}" style="width:4.5rem;padding:.5rem;border-radius:var(--pawly-radius);border:1px solid var(--pawly-border)">
              <strong>{{ item.line_price | money }}</strong>
            </div>
          {%- endfor -%}

          <div class="pawly-card__foot" style="border-top:1px solid var(--pawly-border);padding-top:1.5rem;margin-top:1.5rem">
            <span class="pawly-card__price">{{ 'cart.subtotal' | t }}: {{ cart.total_price | money }}</span>
            <span style="display:flex;gap:.75rem">
              <button class="pawly-btn pawly-btn--ghost" type="submit" name="update">{{ 'cart.update' | t }}</button>
              <button class="pawly-btn pawly-btn--primary" type="submit" name="checkout">{{ 'cart.checkout' | t }}</button>
            </span>
          </div>
        </div>
      {%- endform -%}
    {%- else -%}
      <div class="pawly-section-head">
        <p>{{ 'cart.empty' | t }}</p>
        <a class="pawly-btn pawly-btn--primary" href="{{ routes.all_products_collection_url }}">{{ 'cart.continue' | t }}</a>
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{ "name": "Cart", "settings": [] }
{% endschema %}
