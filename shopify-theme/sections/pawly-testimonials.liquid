{%- comment -%}
  Social proof — three vertically scrolling columns.
  Placeholder reviews until real 4★+ reviews are imported.
{%- endcomment -%}

<section class="pawly-section" id="reviews">
  <div class="pawly-container">
    <div class="pawly-section-head pawly-reveal">
      {%- if section.settings.eyebrow != blank -%}
        <span class="pawly-eyebrow">{{ section.settings.eyebrow }}</span>
      {%- endif -%}
      <h2>{{ section.settings.heading }}</h2>
      {%- if section.settings.subheading != blank -%}
        <p>{{ section.settings.subheading }}</p>
      {%- endif -%}
    </div>

    {%- if section.blocks.size > 0 -%}
      <div class="pawly-testimonials">
        {%- for col in (1..3) -%}
          {%- liquid
            assign target = forloop.index0
            assign duration = forloop.index0 | times: 2 | plus: 15
          -%}
          <div class="pawly-testimonials__col">
            <div class="pawly-testimonials__track" style="--pawly-duration: {{ duration }}s">
              {%- comment -%}Duplicated so translateY(-50%) loops seamlessly.{%- endcomment -%}
              {%- for pass in (1..2) -%}
                {%- for block in section.blocks -%}
                  {%- assign remainder = forloop.index0 | modulo: 3 -%}
                  {%- if remainder == target -%}
                    <figure class="pawly-quote" {{ block.shopify_attributes }}>
                      <p>{{ block.settings.text }}</p>
                      <figcaption class="pawly-quote__author">
                        <span class="pawly-quote__avatar" aria-hidden="true">
                          {{- block.settings.name | slice: 0, 1 -}}
                        </span>
                        <span>
                          <span class="pawly-quote__name">{{ block.settings.name }}</span><br>
                          <span class="pawly-quote__role">{{ block.settings.role }}</span>
                        </span>
                      </figcaption>
                    </figure>
                  {%- endif -%}
                {%- endfor -%}
              {%- endfor -%}
            </div>
          </div>
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Pawly testimonials",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "לקוחות מספרים" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "החבורה כבר אמרה את שלה" },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "בעלים אמיתיים, פרוות אמיתיות, ספות נקיות באמת."
    }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Review",
      "settings": [
        { "type": "textarea", "id": "text", "label": "Review", "default": "ביקורת" },
        { "type": "text", "id": "name", "label": "Name", "default": "שם" },
        { "type": "text", "id": "role", "label": "Pet", "default": "בעלים של" }
      ]
    }
  ],
  "max_blocks": 12,
  "presets": [
    {
      "name": "Pawly testimonials",
      "blocks": [
        { "type": "review", "settings": { "text": "מילו היה מתחבא בכל פעם שהמברשת יצאה. עכשיו הוא מביא לי אותה לבד. לא יודעת מה הקסם, אבל אנחנו נשארים עם זה.", "name": "דנה ר.", "role": "הבעלים של מילו · גולדן רטריבר" } },
        { "type": "review", "settings": { "text": "מכשיר ניקוי הרגליים חסך לי שטיפת רצפה אחרי כל טיול. פשוט מכניסים, מסובבים, וזהו.", "name": "תומר ל.", "role": "הבעלים של לונה · האסקי" } },
        { "type": "review", "settings": { "text": "הזמנתי מידה לא נכונה, כתבתי לשירות, וקיבלתי החלפה עוד לפני שסיימתי את הקפה בבוקר שאחרי.", "name": "מאיה ק.", "role": "הבעלים של ביסקוויט · קוואליר" } },
        { "type": "review", "settings": { "text": "השמפו יוצא ישר מהמברשת ונשטף מהר, וזה קריטי כשהכלב מתייחס לאמבטיה כמו לבריחה מהכלא.", "name": "אמיר ס.", "role": "הבעלים של רוקי · לברדור" } },
        { "type": "review", "settings": { "text": "אחריות 90 יום נשמעה כמו שיווק עד שהשתמשתי בה על מברשת שלא התאימה לפרווה. החזר מלא, בלי שאלות.", "name": "נועה ב.", "role": "הבעלים של פיקסל · בורדר קולי" } },
        { "type": "review", "settings": { "text": "ערכת הטיפוח הראשונה שלא מרגישה כאילו תוכננה על ידי מישהו שמעולם לא פגש כלב שזז.", "name": "דניאל פ.", "role": "הבעלים של צ׳ואי · קוקפו" } },
        { "type": "review", "settings": { "text": "המטפחת שאלה איפה קנינו את המברשת. הרגיש כמו לזכות בפרס.", "name": "שירה א.", "role": "הבעלים של מוקה · פודל" } },
        { "type": "review", "settings": { "text": "גזירת ציפורניים עברה ממאבק של שני אנשים למשימה של פינוק אחד. מילה גדולה, אבל זו המילה הנכונה.", "name": "יואב מ.", "role": "הבעלים של במבה · קורגי" } },
        { "type": "review", "settings": { "text": "המשלוח הגיע מהר והכל מריח עדין במקום כימי. הכלב מאשר. גם הדירה.", "name": "לנה ג.", "role": "הבעלים של וופל · פרנצ׳י" } }
      ]
    }
  ]
}
{% endschema %}
