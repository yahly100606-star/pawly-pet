<section class="pawly-page">
  <div class="pawly-container">
    <div class="pawly-section-head"><h2>{{ 'collections.title' | t }}</h2></div>
    <div class="pawly-products">
      {%- for collection in collections -%}
        <article class="pawly-card pawly-reveal">
          <a class="pawly-card__media" href="{{ collection.url }}" aria-label="{{ collection.title | escape }}">
            {%- if collection.image -%}
              <img src="{{ collection.image | image_url: width: 800 }}" alt="{{ collection.title | escape }}" width="800" height="800" loading="lazy">
            {%- else -%}
              <span class="pawly-card__placeholder">{%- render 'pawly-paw' -%}</span>
            {%- endif -%}
          </a>
          <div class="pawly-card__body">
            <h3 class="pawly-card__title"><a href="{{ collection.url }}">{{ collection.title }}</a></h3>
          </div>
        </article>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{ "name": "Collections list", "settings": [] }
{% endschema %}
