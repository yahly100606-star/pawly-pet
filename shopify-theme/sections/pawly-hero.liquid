{%- comment -%}
  Hero with animated marquee band.
  Marquee pulls product images when they exist, otherwise branded paw tiles.
{%- endcomment -%}

<section class="pawly-hero">
  <div class="pawly-hero__content">
    {%- if section.settings.tagline != blank -%}
      <span class="pawly-hero__tag pawly-reveal">{{ section.settings.tagline }}</span>
    {%- endif -%}

    <h1 class="pawly-hero__title pawly-reveal" style="--pawly-delay: 80ms">
      {{ section.settings.heading }}
    </h1>

    {%- if section.settings.description != blank -%}
      <p class="pawly-hero__desc pawly-reveal" style="--pawly-delay: 160ms">
        {{ section.settings.description }}
      </p>
    {%- endif -%}

    {%- if section.settings.cta_label != blank -%}
      <div class="pawly-hero__cta pawly-reveal" style="--pawly-delay: 240ms">
        <a
          class="pawly-btn pawly-btn--primary"
          href="{{ section.settings.cta_url | default: routes.all_products_collection_url }}"
        >
          {{ section.settings.cta_label }}
        </a>
      </div>
    {%- endif -%}
  </div>

  {%- liquid
    # Same guard as the products section: collections[blank] is nil.
    assign marquee_products = collections.all.products
    if section.settings.collection != blank
      assign chosen = collections[section.settings.collection]
      if chosen.products.size > 0
        assign marquee_products = chosen.products
      endif
    endif
  -%}

  <div class="pawly-marquee" aria-hidden="true">
    <div class="pawly-marquee__track">
      {%- comment -%}Rendered twice so translateX(-50%) loops seamlessly.{%- endcomment -%}
      {%- for i in (1..2) -%}
        {%- for product in marquee_products limit: 8 -%}
          <div class="pawly-marquee__item">
            {%- if product.featured_image -%}
              <img
                src="{{ product.featured_image | image_url: width: 600 }}"
                alt=""
                width="600"
                height="800"
                loading="lazy"
              >
            {%- else -%}
              <span class="pawly-card__placeholder">{%- render 'pawly-paw' -%}</span>
            {%- endif -%}
          </div>
        {%- endfor -%}
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Pawly hero",
  "settings": [
    {
      "type": "text",
      "id": "tagline",
      "label": "Tagline",
      "default": "מאושר על ידי וטרינרים · אחריות 90 יום"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "טיפוח שהכלב שלכם באמת נהנה ממנו"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "מוצרי טיפוח עדינים לכלבים ולחתולים שהופכים את זמן הרחצה מקרב היאבקות לרגע נעים. אם החיה שלכם לא מרוצה יותר תוך 90 יום — הכסף חוזר."
    },
    { "type": "text", "id": "cta_label", "label": "Button label", "default": "לכל מוצרי הטיפוח" },
    { "type": "url", "id": "cta_url", "label": "Button link" },
    { "type": "collection", "id": "collection", "label": "Marquee images from collection" }
  ],
  "presets": [{ "name": "Pawly hero" }]
}
{% endschema %}
