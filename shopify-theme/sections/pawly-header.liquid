{%- comment -%}Sticky navbar — scroll-aware blur + mobile menu.{%- endcomment -%}

<header class="pawly-header" data-pawly-header>
  <div class="pawly-container">
    <div class="pawly-header__bar">
      <a class="pawly-logo" href="{{ routes.root_url }}">
        <span class="pawly-logo__mark">{%- render 'pawly-paw' -%}</span>
        {{ section.settings.brand_name | default: shop.name }}
      </a>

      <nav class="pawly-nav" aria-label="{{ 'accessibility.main_nav' | t }}">
        {%- for link in section.settings.menu.links -%}
          <a href="{{ link.url }}">{{ link.title }}</a>
        {%- endfor -%}
      </nav>

      {%- if section.settings.cta_label != blank -%}
        <a
          class="pawly-btn pawly-btn--primary pawly-btn--sm pawly-header__cta"
          href="{{ section.settings.cta_url | default: routes.all_products_collection_url }}"
        >
          {{ section.settings.cta_label }}
        </a>
      {%- endif -%}

      <button
        class="pawly-burger"
        type="button"
        data-pawly-burger
        aria-expanded="false"
        aria-controls="PawlyMobileMenu"
      >
        <svg class="icon-open" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
          <path d="M4 6h16M4 12h16M4 18h16"/>
        </svg>
        <svg class="icon-close" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
          <path d="M6 6l12 12M18 6L6 18"/>
        </svg>
        <span class="visually-hidden">{{ 'accessibility.menu' | t }}</span>
      </button>
    </div>
  </div>

  <div class="pawly-mobile-menu" id="PawlyMobileMenu" data-pawly-menu>
    <div class="pawly-container">
      <div class="pawly-mobile-menu__inner">
        {%- for link in section.settings.menu.links -%}
          <a href="{{ link.url }}">{{ link.title }}</a>
        {%- endfor -%}
        {%- if section.settings.cta_label != blank -%}
          <a
            class="pawly-btn pawly-btn--primary"
            href="{{ section.settings.cta_url | default: routes.all_products_collection_url }}"
          >
            {{ section.settings.cta_label }}
          </a>
        {%- endif -%}
      </div>
    </div>
  </div>
</header>

{% schema %}
{
  "name": "Pawly header",
  "settings": [
    { "type": "text", "id": "brand_name", "label": "Brand name", "default": "pawly" },
    { "type": "link_list", "id": "menu", "label": "Menu", "default": "main-menu" },
    { "type": "text", "id": "cta_label", "label": "Button label", "default": "לחנות" },
    { "type": "url", "id": "cta_url", "label": "Button link" }
  ],
  "enabled_on": { "groups": ["header"] }
}
{% endschema %}
