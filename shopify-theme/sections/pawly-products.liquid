{%- comment -%}
  Product grid — the Shopify-native replacement for the landing page's
  fixed pricing tiers. Pulls live products, prices and variants.
{%- endcomment -%}

{%- liquid
  # Default to every product; narrow to the chosen collection when one is set
  # and actually has products. collections[blank] is nil, so guard explicitly.
  assign products = collections.all.products
  if section.settings.collection != blank
    assign chosen = collections[section.settings.collection]
    if chosen.products.size > 0
      assign products = chosen.products
    endif
  endif
-%}

<section class="pawly-section pawly-section--tinted" id="pricing">
  <div class="pawly-container">
    <div class="pawly-section-head pawly-reveal">
      {%- if section.settings.eyebrow != blank -%}
        <span class="pawly-eyebrow">{{ section.settings.eyebrow }}</span>
      {%- endif -%}
      <h2>{{ section.settings.heading }}</h2>
      {%- if section.settings.subheading != blank -%}
        <p>{{ section.settings.subheading }}</p>
      {%- endif -%}
    </div>

    {%- if products.size > 0 -%}
      <div class="pawly-products">
        {%- for product in products limit: section.settings.products_to_show -%}
          {%- render 'pawly-product-card',
            product: product,
            delay: forloop.index0 | times: 90
          -%}
        {%- endfor -%}
      </div>
    {%- else -%}
      <p class="pawly-section-head">{{ 'products.empty' | t }}</p>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Pawly products",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "המוצרים שלנו" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "בחרו את הטיפוח שלכם" },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "כל המוצרים מגיעים עם הבטחת Pawly ל-90 יום."
    },
    { "type": "collection", "id": "collection", "label": "Collection" },
    {
      "type": "range",
      "id": "products_to_show",
      "label": "Products to show",
      "min": 3,
      "max": 24,
      "step": 1,
      "default": 8
    }
  ],
  "presets": [{ "name": "Pawly products" }]
}
{% endschema %}
